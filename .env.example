# Copy this file to .env and fill in the keys you have.
# The agent works with zero keys (yfinance needs none), but each optional
# key unlocks richer data. See README.md for where to get free-tier keys.

# Required for AI-written narrative analysis & predictions. Free tier,
# no credit card needed. Without it, the report still runs but skips the
# narrative section.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: richer news, analyst recommendation trends, and insider
# transaction data. Free tier available.
# https://finnhub.io/register
FINNHUB_API_KEY=

# Optional: broader business/press-release news search. Free tier available.
# https://newsapi.org/register
NEWSAPI_KEY=

# Optional: macroeconomic series (interest rates, CPI, PCE, etc.). Free.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
